# Copy to .env.local (git-ignored by .gitignore; a plain .env is NOT ignored) and fill in from Supabase: Project Settings -> API.
# Both values are safe to ship in the client; Row Level Security protects the data.
# NEVER put the service_role key here: EXPO_PUBLIC_* variables are bundled into the app.
# Leave both empty to run the app fully offline in demo mode.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
