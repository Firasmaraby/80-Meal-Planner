{
  "_comment": "Used by stages/servings.py ONLY when the source gave no portion data for a food. First matching rule wins. name_pattern is a case-insensitive regex on the cleaned name; states lists allowed preparation states ('' = no state). Weights are typical USDA household-measure weights; add entries only where the unit weight is well known - a wrong default is worse than none.",
  "rules": [
    {"id": "nut_butter", "categories": ["nut_seed"], "name_pattern": "butter|tahini|paste",
     "servings": [{"label": "1 tbsp", "g": 16}]},
    {"id": "fats_spoons", "categories": ["oil_fat"], "name_pattern": "oil|butter|margarine|lard|ghee|shortening|spread",
     "servings": [{"label": "1 tbsp", "g": 14}, {"label": "1 tsp", "g": 4.7}]},
    {"id": "egg_whole", "categories": ["egg"], "name_pattern": "^eggs?(,|$)(?!.*(white|yolk|substitute|powder|dried))",
     "states": ["raw", "boiled", "poached", "fried", "scrambled", "baked", ""],
     "servings": [{"label": "1 large", "g": 50}]},
    {"id": "apple", "categories": ["fruit"], "name_pattern": "^apples?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 182}]},
    {"id": "banana", "categories": ["fruit"], "name_pattern": "^bananas?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 118}]},
    {"id": "orange", "categories": ["fruit"], "name_pattern": "^oranges?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 131}]},
    {"id": "pear", "categories": ["fruit"], "name_pattern": "^pears?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 178}]},
    {"id": "peach", "categories": ["fruit"], "name_pattern": "^peach(es)?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 150}]},
    {"id": "plum", "categories": ["fruit"], "name_pattern": "^plums?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 66}]},
    {"id": "kiwi", "categories": ["fruit"], "name_pattern": "^kiwi(fruit)?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 69}]},
    {"id": "avocado", "categories": ["fruit"], "name_pattern": "^avocados?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 136}]},
    {"id": "lemon", "categories": ["fruit"], "name_pattern": "^lemons?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 58}]},
    {"id": "strawberries", "categories": ["fruit"], "name_pattern": "^strawberr(y|ies)(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 cup, whole", "g": 144}]},
    {"id": "blueberries", "categories": ["fruit"], "name_pattern": "^blueberr(y|ies)(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 cup", "g": 148}]},
    {"id": "grapes", "categories": ["fruit"], "name_pattern": "^grapes?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 cup", "g": 151}]},
    {"id": "tomato", "categories": ["vegetable"], "name_pattern": "^tomatoes?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 123}]},
    {"id": "carrot", "categories": ["vegetable"], "name_pattern": "^carrots?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 61}]},
    {"id": "potato", "categories": ["vegetable"], "name_pattern": "^potato(es)?(,|$)", "states": ["raw", "baked", "boiled", ""],
     "servings": [{"label": "1 medium", "g": 173}]},
    {"id": "onion", "categories": ["vegetable"], "name_pattern": "^onions?(,|$)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 110}]},
    {"id": "bell_pepper", "categories": ["vegetable"], "name_pattern": "^(bell |sweet )?peppers?, (sweet|red|green|yellow)", "states": ["raw", ""],
     "servings": [{"label": "1 medium", "g": 119}]},
    {"id": "milk_cup", "categories": ["dairy"], "name_pattern": "^(milk|buttermilk|kefir)\\b",
     "servings": [{"label": "1 cup", "g": 244}]},
    {"id": "yogurt_cup", "categories": ["dairy"], "name_pattern": "yogurt",
     "servings": [{"label": "1 cup", "g": 245}]},
    {"id": "cheese_oz", "categories": ["dairy"], "name_pattern": "cheese",
     "servings": [{"label": "1 oz", "g": 28.35}]},
    {"id": "nuts_oz", "categories": ["nut_seed"], "name_pattern": ".",
     "servings": [{"label": "1 oz", "g": 28.35}]},
    {"id": "beverage_cup", "categories": ["beverage"], "name_pattern": ".",
     "servings": [{"label": "1 cup", "g": 240}]},
    {"id": "protein_3oz", "categories": ["meat", "poultry", "fish"], "name_pattern": ".",
     "servings": [{"label": "3 oz", "g": 85}]},
    {"id": "bread_slice", "categories": ["grain"], "name_pattern": "\\bbread\\b", "states": [""],
     "servings": [{"label": "1 slice", "g": 30}]},
    {"id": "rice_cooked", "categories": ["grain"], "name_pattern": "\\brice\\b", "states": ["boiled", "cooked", "steamed"],
     "servings": [{"label": "1 cup, cooked", "g": 158}]},
    {"id": "pasta_cooked", "categories": ["grain"], "name_pattern": "pasta|spaghetti|macaroni|noodles", "states": ["boiled", "cooked"],
     "servings": [{"label": "1 cup, cooked", "g": 140}]}
  ]
}
